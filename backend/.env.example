AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Separate free model budget for read-only research summaries.
GROQ_RESEARCH_MODEL=openai/gpt-oss-20b
PORT=3000

# Optional. When set, Language ORTA coaching requires a signed-in student token;
# without it local development stays open. Persistence and private transcripts
# stay in Supabase with student-only RLS.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Tavily free plan: 1000 credits/month, no card; basic search only.
RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Optional no-key provider: set RESEARCH_PROVIDER=searxng and a JSON-enabled instance.
SEARXNG_URL=https://searx.tiekoetter.com/
